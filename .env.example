# Copy these settings into your LOCAL .env. Never commit a real API key.
OPENAI_API_KEY=

# One active dataset for every pipeline and the local frontend.
# Dataset names and display metadata are registered in config/datasets.json.
RAG_DATASET=slic

# Optional: all settings below already have these defaults.
OPENAI_MODEL=gpt-5-nano
OPENAI_REASONING_EFFORT=minimal
OPENAI_MAX_OUTPUT_TOKENS=1800
RAG_CONTEXT_TOKEN_BUDGET=6000

# GPT-5 nano is scheduled for API removal on 2026-12-11.
# Alternative: OPENAI_MODEL=gpt-6-luna and OPENAI_REASONING_EFFORT=none.

# Leave empty to use the active dataset's isolated local Qdrant index.
QDRANT_URL=
QDRANT_API_KEY=

# Optional explicit storage overrides, shared by indexing, retrieval, and API.
# RAG_QDRANT_PATH=
# RAG_QDRANT_COLLECTION=

# Private token used by the Next.js SERVER when calling FastAPI.
# Generate locally with: python -m src.api.setup
# Never use a NEXT_PUBLIC_ prefix for this token or your OpenAI key.
RAG_BACKEND_API_KEY=
RAG_API_REQUESTS_PER_MINUTE=20
RAG_API_REQUESTS_PER_DAY=200
RAG_API_SAVE_ARTIFACTS=true

# The recommended Next.js server proxy needs no CORS setting.
# Optional explicit browser origins, comma-separated, with no trailing slash.
RAG_ALLOWED_ORIGINS=
